\subsection{Method \code{node_colors()}}{
Configure node coloring mode for ligand and receptor nodes
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{SankeyPlot$node_colors(mode = c("cell_type", "weighted_mix"))}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{mode}}{One of "cell_type" or "weighted_mix".
\itemize{
\item "cell_type" (default): Ligand nodes use a neutral color, receptor nodes use
a neutral color. This is the simple default behavior.
\item "weighted_mix": Ligand node colors are computed by mixing sender cell colors
weighted by scaled_ligand_expression. Receptor node colors are computed by
mixing ligand colors weighted by scaled_receptor_expression. This creates
a visual flow where colors blend through the network.
}}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
Self (invisibly) for chaining
}
\subsection{Examples}{
