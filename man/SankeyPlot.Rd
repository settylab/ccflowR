\subsection{Method \code{flow_method()}}{
Configure edge weight computation method
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{SankeyPlot$flow_method(
  method = c("auto", "weighted", "flow_conserving", "uniform")
)}\if{html}{\out{</div>}}
